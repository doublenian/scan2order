# 服务端口与运行环境
PORT=3000
NODE_ENV=development
TZ=Asia/Shanghai

# 数据库（SQLite 文件；测试使用内存库，不受此项影响）
DATABASE_PATH=./data/scan2order.db

# 后台 JWT 签名密钥：务必替换为随机值，例如 openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# 前端开发服务器源与 H5 二维码基地址
CORS_ORIGINS=http://localhost:5173
H5_BASE_URL=http://localhost:5173

# 图片上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2

# 种子管理员：执行 db:seed 时必须提供，不提供即报错退出
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
